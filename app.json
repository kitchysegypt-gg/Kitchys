{
  "expo": {
    "name": "Kitchy's",
    "slug": "kitchys",
    "version": "3.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kitchys",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitchys.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kitchys.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-kitchys.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F8F1E6"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kitchy's uses your location to set your delivery address on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitchy's uses your photos so home chefs can add pictures of themselves and their dishes.",
          "cameraPermission": "Kitchy's uses the camera so home chefs can take pictures of their dishes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F4511E",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "kitchyss-teamg",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5e03ab0-c164-4b3e-a9ae-b56d7377ff57"
      }
    },
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/d5e03ab0-c164-4b3e-a9ae-b56d7377ff57"
    }
  }
}
